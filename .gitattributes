# Binary assets: never convert line endings, never try to diff them as text.
# There is deliberately no Git LFS here: the repository is small (~112MB of history) and LFS
# adds a dependency to every clone and to CI. If the repo is ever shared widely, revisit
# `CHANGELOG.md` (N4) instead of adding filters silently.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf

*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.m4a binary
*.flac binary

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.glsl text eol=lf
*.sh text eol=lf
