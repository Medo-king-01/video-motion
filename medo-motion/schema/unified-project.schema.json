{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Medo-king-01/video-motion/blob/main/medo-motion/schema/unified-project.schema.json",
  "title": "Unified motion project",
  "description": "Experimental 1.0 and 1.1 subsets: structural validation only. Semantic validation is performed by tools/unified_project_check.py. No P/K/R/Hybrid backend integration.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "den": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "sampleRate"
      ],
      "additionalProperties": false
    },
    "timebase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "profile",
    "timebase",
    "duration",
    "seed",
    "assets",
    "tracks"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "video",
                  "audio"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "duration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "duration"
              ]
            }
          }
        }
      ]
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "text",
            "graphics"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "enabled",
        "clips"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "const": "media"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceIn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/curve"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "assetId",
        "start",
        "duration",
        "sourceIn",
        "effects",
        "keyframes"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "enum": [
            "opacity",
            "gain"
          ]
        },
        "version": {
          "const": 1,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "params": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "enabled",
        "params"
      ],
      "additionalProperties": false
    },
    "curve": {
      "type": "object",
      "properties": {
        "effectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "property": {
          "const": "value"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      },
      "required": [
        "effectId",
        "property",
        "points"
      ],
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "interpolation": {
          "enum": [
            "linear",
            "hold"
          ]
        }
      },
      "required": [
        "t",
        "value",
        "interpolation"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "crossfade"
          ]
        },
        "fromClipId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "toClipId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "duration": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "kind",
        "fromClipId",
        "toClipId",
        "duration"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "tracks": {
            "items": {
              "properties": {
                "clips": {
                  "items": {
                    "properties": {
                      "effects": {
                        "maxItems": 0
                      },
                      "keyframes": {
                        "maxItems": 0
                      }
                    }
                  }
                },
                "transitions": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "tracks": {
            "items": {
              "properties": {
                "clips": {
                  "items": {
                    "properties": {}
                  }
                },
                "transitions": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
