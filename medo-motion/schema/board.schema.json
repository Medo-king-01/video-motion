{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Medo-king-01/video-motion/blob/main/medo-motion/schema/board.schema.json",
  "title": "Declarative board (B2) — structural subset",
  "description": "A board is data: scenes, elements and moves. Semantic validation (brand colours, pose names, move ids, timing, ids) lives in tools/board_check.py; this schema is the structural reference only.",
  "type": "object",
  "required": ["version", "stage", "duration", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "stage": {
      "type": "object",
      "required": ["width", "height", "background"],
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "background": {"type": "string", "minLength": 1}
      }
    },
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "start", "duration", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "camera": {"$ref": "#/$defs/move"},
        "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}}
      }
    },
    "move": {
      "type": "object",
      "required": ["move"],
      "additionalProperties": false,
      "properties": {
        "move": {"type": "string", "minLength": 1},
        "params": {"type": "object"}
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "kind": {"enum": ["text", "shape", "draw", "data", "person", "image"]},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "integer"},
        "at": {"type": "number", "minimum": 0},
        "move": {"$ref": "#/$defs/move"},
        "text": {"type": "string", "minLength": 1},
        "size": {"type": "number", "exclusiveMinimum": 0},
        "font": {"type": "string", "minLength": 1},
        "color": {"type": "string", "minLength": 1},
        "align": {"enum": ["right", "center", "left"]},
        "maxWidth": {"type": "number", "exclusiveMinimum": 0},
        "shape": {"enum": ["rect", "ellipse", "line"]},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "fill": {"type": "string", "minLength": 1},
        "stroke": {"type": "string", "minLength": 1},
        "strokeWidth": {"type": "number", "minimum": 0},
        "radius": {"type": "number", "minimum": 0},
        "points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "arrow": {"type": "boolean"},
        "values": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "number"}},
        "gap": {"type": "number", "minimum": 0, "maximum": 0.9},
        "pose": {"type": "string", "minLength": 1},
        "src": {"type": "string", "pattern": "\\S"},
        "fit": {"enum": ["cover", "contain"]}
      }
    }
  }
}
