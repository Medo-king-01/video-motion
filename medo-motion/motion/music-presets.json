{
  "_doc": "Procedural music vocabulary shared by music.py (Python), tools/music_kit.py and the engines. A preset is a musical configuration, not a volume setting: it names the key/scale, a progression, a BPM range, a section-shape default, which layers play, and how each layer is voiced. Every preset must be playable and deterministic. Colours/levels are in dB relative to the bed's own RMS, never absolute.",
  "version": 1,
  "_levels": "`levelTrimDb` is a MEASURED correction (see tools/music_kit.py --levels): it brings every preset to the same perceived level (-19 dBFS RMS on a 24 s bed), because the arrangement density differs by up to 15 dB between, say, `ambient` and `energetic`. It is not a taste knob.",
  "sections": {
    "_doc": "A bed is divided into sections. `ratio` is the share of the requested duration; `bars` pins a section to a whole number of bars. Both are optional; when a section list is given explicitly the ratio is ignored.",
    "names": ["intro", "build", "drop", "break", "outro", "stop"],
    "intro": {
      "ar": "مقدمة",
      "en": "Intro",
      "default_ratio": 0.12,
      "layers": ["pad", "pluck", "kick"],
      "density": 0.62,
      "note": "sets the key and the feel; no clap, no full bass, brightness rolled off"
    },
    "build": {
      "ar": "تصعيد",
      "en": "Build",
      "default_ratio": 0.14,
      "layers": ["pad", "kick", "hat", "bass", "pluck"],
      "density": 0.65,
      "note": "filter opens, snare roll in the last bar, no clap"
    },
    "drop": {
      "ar": "الدروب",
      "en": "Drop",
      "default_ratio": 0.44,
      "layers": ["kick", "clap", "hat", "bass", "pad", "pluck", "melody", "texture"],
      "density": 1.0,
      "note": "full arrangement; crash accent on entry; sidechain pump active"
    },
    "break": {
      "ar": "فاصل",
      "en": "Break",
      "default_ratio": 0.18,
      "layers": ["pad", "texture", "bass", "hat", "pluck"],
      "density": 0.5,
      "note": "pulse survives but reduced; the pulse never disappears entirely under a VO"
    },
    "outro": {
      "ar": "خاتمة",
      "en": "Outro",
      "default_ratio": 0.12,
      "layers": ["pad", "kick", "bass", "pluck"],
      "density": 0.55,
      "note": "resolves, fades, no clap"
