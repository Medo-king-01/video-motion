  "formulas": {
    "smoothstep": "quadInOut",
    "smootherstep": "quintInOut",
    "quadIn": "t*t",
    "quadOut": "1-(1-t)^2",
    "quadInOut": "t<.5 ? 2t^2 : 1-(-2t+2)^2/2",
    "cubicIn": "t^3",
    "cubicOut": "1-(1-t)^3",
    "cubicInOut": "t<.5 ? 4t^3 : 1-(-2t+2)^3/2",
    "quartIn": "t^4",
    "quartOut": "1-(1-t)^4",
    "quartInOut": "t<.5 ? 8t^4 : 1-(-2t+2)^4/2",
    "quintIn": "t^5",
    "quintOut": "1-(1-t)^5",
    "quintInOut": "t<.5 ? 16t^5 : 1-(-2t+2)^5/2",
    "sineIn": "1-cos(t*PI/2)",
    "sineOut": "sin(t*PI/2)",
    "sineInOut": "-(cos(PI*t)-1)/2",
    "expoIn": "t==0 ? 0 : 2^(10t-10)",
    "expoOut": "t==1 ? 1 : 1-2^(-10t)",
    "expoInOut": "t==0 ? 0 : t==1 ? 1 : t<.5 ? 2^(20t-10)/2 : (2-2^(-20t+10))/2",
    "elasticIn": "t==0 ? 0 : t==1 ? 1 : -2^(10t-10)*sin((10t-10.75)*2PI/3)",
    "elasticOut": "t==0 ? 0 : t==1 ? 1 : 2^(-10t)*sin((10t-0.75)*2PI/3)+1",
    "elasticInOut": "t==0 ? 0 : t==1 ? 1 : t<.5 ? -(2^(20t-10)*sin((20t-11.125)*2PI/4.5))/2 : (2^(-20t+10)*sin((20t-11.125)*2PI/4.5))/2+1",
    "bounceIn": "1-bounceOut(1-t)",
    "bounceOut": "n1=7.5625, d1=2.75 (piecewise parabolas)",
    "bounceInOut": "t<.5 ? (1-bounceOut(1-2t))/2 : (1+bounceOut(2t-1))/2"
  },
  "formulaDoc": "Readable equations only — the engines hold the executable copies and tests/test_motion.py compares JS↔Python sample by sample."
