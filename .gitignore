# node
node_modules/
package-lock.json.bak

# The studio is a tool, not a video archive: project folders are working copies and
# never part of this repository's history. Old renders must not pile up in Git.
projects/*
!projects/README.md
*.mp4
*_preview.mp4

# tooling caches / local previews
.venv/
venv/
cache/
.cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
tools/bin/
.DS_Store

# secrets — never commit
.env
*.key

# other generated output (sources and plans remain trackable)
out/
*.env
.env.*
.env-*
!.env.example
studio-venv/
